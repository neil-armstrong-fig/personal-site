{
  "name": "personal-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @personal-site/webapp dev",
    "preview": "pnpm --filter @personal-site/webapp preview",
    "build": "pnpm checks && pnpm --filter @personal-site/webapp compile",
    "checks": "pnpm --recursive checks && pnpm format:check:root",
    "lint": "pnpm --recursive lint",
    "lint:fix": "node webapp/src/scripts/run-scoped-command/RunScopedCommand.ts eslint --max-warnings=0 --fix --",
    "format": "node webapp/src/scripts/run-scoped-command/RunScopedCommand.ts prettier --write --",
    "format:check": "pnpm --recursive format:check && pnpm format:check:root",
    "type-check": "pnpm --recursive type-check",
    "test": "pnpm --recursive test",
    "validate:build": "pnpm --filter @personal-site/webapp validate:build",
    "lighthouse": "pnpm --filter @personal-site/webapp lighthouse",
    "indexnow:submit": "pnpm --filter @personal-site/webapp indexnow:submit",
    "strava:sync": "pnpm --filter @personal-site/webapp strava:sync",
    "strava:sync-media": "pnpm --filter @personal-site/webapp strava:sync-media",
    "trip:photos": "pnpm --filter @personal-site/webapp trip:photos",
    "trip:videos": "pnpm --filter @personal-site/webapp trip:videos",
    "format:check:root": "prettier --check \"*.{md,json,yaml}\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "@personal-site/shared": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
