---
import {Picture} from "astro:assets";

import ExternalLink from "@src/components/actions/external-link/ExternalLink.astro";
import portraitImage from "@src/assets/portrait/neil-armstrong.jpg";

import FlipButton from "@src/pages/bc/_components/business-card/components/flip-button/FlipButton.astro";
import {businessCardContent} from "@src/pages/bc/_components/business-card/content/BusinessCardContent";

// Everything is sized in cqw, a percentage of the card's width, so the card scales like a printed one. The page's only
// heading is the name.
const {name, title, location, portraitAlt, links} = businessCardContent;
---

<div class="relative grid size-full grid-cols-[36fr_64fr] overflow-hidden rounded-[2.5cqw] border border-line bg-paper-muted text-ink shadow-[0_1.5rem_2.5rem_-1.25rem_rgb(0_0_0/0.45)]">
  <div class="relative overflow-hidden bg-fill-forest [&_img]:size-full [&_img]:object-cover [&_img]:object-[50%_30%] [&_picture]:block [&_picture]:size-full">
    <Picture
      src={portraitImage}
      formats={["avif", "webp"]}
      widths={[240, 480]}
      sizes="(min-width: 40rem) 13rem, 36vw"
      alt={portraitAlt}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="flex flex-col justify-between p-[5cqw]">
    <div>
      <h1 class="m-0 font-serif text-[max(1.4rem,8cqw)] leading-[1.05] font-semibold tracking-[-0.02em] text-ink">
        {name}
      </h1>

      <p class="m-0 mt-[1.8cqw] text-[max(0.8rem,3.5cqw)] leading-[1.25] font-bold text-forest">{title}</p>

      <p class="m-0 mt-[1cqw] text-[max(0.75rem,3.2cqw)] leading-[1.25] text-ink">{location}</p>
    </div>

    <ul class="m-0 flex list-none flex-col gap-[0.6cqw] p-0 text-[max(0.75rem,3.2cqw)] leading-[1.3]">
      {links.map(link => (
        <li>
          <ExternalLink href={link.href}>{link.label}</ExternalLink>
        </li>
      ))}
    </ul>
  </div>

  <div class="absolute right-[4cqw] bottom-[4cqw]">
    <FlipButton tone="paper" hiddenLabel="to see the back" />
  </div>
</div>
