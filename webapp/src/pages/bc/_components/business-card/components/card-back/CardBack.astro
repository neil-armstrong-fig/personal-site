---
import FlipButton from "@src/pages/bc/_components/business-card/components/flip-button/FlipButton.astro";
import {businessCardContent} from "@src/pages/bc/_components/business-card/content/BusinessCardContent";

// The back is a large dark fill, so it uses the fill and on-fill roles, which swap together in the dark theme.
const {sections, cycling} = businessCardContent;
---

<div class="flex size-full flex-col justify-between overflow-hidden rounded-[2.5cqw] border border-line bg-fill-forest p-[5cqw] text-on-fill shadow-[0_1.5rem_2.5rem_-1.25rem_rgb(0_0_0/0.45)]">
  <div class="grid grid-cols-2 gap-x-[4cqw] gap-y-[3.2cqw]">
    {sections.map(section => (
      <section>
        <h2 class="m-0 font-sans text-[max(0.7rem,2.7cqw)] leading-[1.2] font-bold tracking-[0.1em] text-on-fill uppercase">
          {section.heading}
        </h2>

        <p class="m-0 mt-[0.8cqw] text-[max(0.75rem,3.2cqw)] leading-[1.3] text-on-fill">
          {section.lines.map(line => (
            <span class="block">{line}</span>
          ))}
        </p>
      </section>
    ))}
  </div>

  <div class="flex items-end justify-between gap-[3cqw]">
    <p class="m-0 text-[max(0.75rem,3.2cqw)] leading-[1.3] text-on-fill">{cycling}</p>

    <FlipButton tone="fill" hiddenLabel="back to the front" />
  </div>
</div>
