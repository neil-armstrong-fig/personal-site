---
import type {ImageMetadata} from "astro";
import ThemedImage from "@src/pages/_components/themed-image/ThemedImage.astro";

interface Props {
  image: ImageMetadata;
  mobileImage: ImageMetadata;
  imageDark?: ImageMetadata;
  mobileImageDark?: ImageMetadata;
  alt: string;
}

const {image, mobileImage, imageDark, mobileImageDark, alt} = Astro.props;
---

<figure class="mb-12 overflow-hidden rounded-lg border border-line/20">
  <ThemedImage
    src={image}
    mobileSrc={mobileImage}
    darkSrc={imageDark}
    darkMobileSrc={mobileImageDark}
    alt={alt}
    widths={[800, 1200, 1600]}
    sizes="(min-width: 80rem) 76rem, calc(100vw - 3rem)"
    quality={90}
  />
</figure>
