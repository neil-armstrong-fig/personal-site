---
import Eyebrow from "@src/components/typography/eyebrow/Eyebrow.astro";

interface Proof {
  title: string;
  detail: string;
  href: string;
}

// Each claim is taken from the linked case study, which holds the evidence and says what it measures.
const proofs: readonly Proof[] = [
  {
    title: "Build it new",
    detail: "A one-week Android prototype won the work and became a production app.",
    href: "/software/point-of-sale-android-rewrite/",
  },
  {
    title: "Change it safely",
    detail:
      "More than 50 Lambdas rebuilt in four weeks and a business critical loan processing webapp fully rebuilt in four months, with no regressions.",
    href: "/software/build-it-again-better/",
  },
  {
    title: "Leadership and ownership",
    detail:
      "Took over two struggling teams on a full rewrite / modernisation engagement, and shipped both on tight deadlines.",
    href: "/software/platform-modernisation-back-on-track/",
  },
];
---

<Eyebrow>What I bring</Eyebrow>

<dl class="grid gap-6 md:grid-cols-3 md:gap-8">
  {proofs.map(proof => (
    <div class="relative border-l-2 border-moss pl-4 md:border-l-0 md:pl-0">
      <dt class="font-serif text-[clamp(2rem,1.6rem+1.6vw,3rem)] leading-none tracking-[-0.03em] text-forest">
        {proof.title}
      </dt>

      <dd class="mt-2 mb-0 max-w-[24rem]">
        <a class="after:absolute after:inset-0" href={proof.href}>
          {proof.detail}
        </a>
      </dd>
    </div>
  ))}
</dl>
