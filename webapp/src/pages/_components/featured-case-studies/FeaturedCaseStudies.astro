---
import type {CollectionEntry} from "astro:content";

import ProfessionalCaseStudyCard from "@src/pages/software/_components/professional-case-study-card/ProfessionalCaseStudyCard.astro";
import {selectHomepageCaseStudies} from "./homepage-case-studies/SelectHomepageCaseStudies";

interface Props {
  caseStudies: CollectionEntry<"professionalCaseStudies">[];
}

const {caseStudies} = Astro.props;
const homepageCaseStudies = selectHomepageCaseStudies(caseStudies);
---

<ul class="grid list-none gap-4 p-0 md:grid-cols-3">
  {homepageCaseStudies.map(caseStudy => (
    <li>
      <ProfessionalCaseStudyCard caseStudy={caseStudy} level={3} compact />
    </li>
  ))}
</ul>
