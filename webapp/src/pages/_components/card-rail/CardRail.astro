---
// A list of cards that swipes sideways on a phone and becomes a grid from `md`. CSS only: every card is in the HTML, so
// nothing depends on JavaScript. The scroller sits outside `Container` and carries the page gutter as padding, because
// negative margins are banned. Each child must be an `<li>`.
type RailColumns = "two" | "three";

interface Props {
  label: string;
  columns?: RailColumns;
}

const {label, columns = "three"} = Astro.props;
---

<ul
  aria-label={label}
  class:list={[
    "m-0 flex list-none snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain scroll-px-6 px-6 pb-4 *:w-[82%] *:max-w-96 *:shrink-0 *:snap-start",
    "md:mx-auto md:grid md:w-[min(calc(100%-3rem),var(--container-page))] md:snap-none md:grid-cols-2 md:overflow-visible md:px-0 md:pb-0 md:*:w-auto md:*:max-w-none",
    columns === "three" && "lg:grid-cols-3",
  ]}
>
  <slot />
</ul>

<p class="mt-2 px-6 text-[0.8rem] font-bold tracking-[0.06em] text-forest uppercase md:hidden" aria-hidden="true">
  Swipe for more →
</p>
