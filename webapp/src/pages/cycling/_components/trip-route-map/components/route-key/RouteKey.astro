---
import RouteVisibilityControls from "@src/pages/cycling/_components/route-visibility-controls/RouteVisibilityControls.astro";

interface Props {
  hasBonus: boolean;
  hasFerries: boolean;
  hasOutings: boolean;
  hasTransit: boolean;
}

const {hasBonus, hasFerries, hasOutings, hasTransit} = Astro.props;
---

<div
  class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.66rem] leading-none text-ink/75"
  aria-label="Route map key"
  data-trip-route-key
>
  <span class="inline-flex items-center gap-1" data-route-key-kind="day">
    <svg class="h-2 w-6" viewBox="0 0 24 8" aria-hidden="true">
      <path class="stroke-petrol" d="M1 4h6" fill="none" stroke-width="3" stroke-linecap="round"></path>
      <path class="stroke-copper" d="M9 4h6" fill="none" stroke-width="3" stroke-linecap="round"></path>
      <path class="stroke-forest" d="M17 4h6" fill="none" stroke-width="3" stroke-linecap="round"></path>
    </svg>
    Day
  </span>

  {hasBonus && (
    <span class="inline-flex items-center gap-1" data-route-key-kind="bonus">
      <svg class="h-2 w-6" viewBox="0 0 24 8" aria-hidden="true">
        <path
          class="stroke-copper"
          d="M1 4h22"
          fill="none"
          stroke-width="7"
          stroke-linecap="round"
          stroke-dasharray="2 7"
        ></path>
        <path class="stroke-petrol" d="M1 4h22" fill="none" stroke-width="3" stroke-linecap="round"></path>
      </svg>
      Bonus
    </span>
  )}

  <RouteVisibilityControls hasFerries={hasFerries} hasOutings={hasOutings} hasTransit={hasTransit} />
</div>
