---
import {Image} from "astro:assets";
import type {CollectionEntry} from "astro:content";

import Eyebrow from "@src/components/typography/eyebrow/Eyebrow.astro";
import type {CaseStudyHeadingLevel} from "@src/pages/software/_components/types/CaseStudyHeadingLevel";

interface Props {
  project: CollectionEntry<"projects">;
  level?: CaseStudyHeadingLevel;
}

const {project, level = 2} = Astro.props;
const Heading = `h${level}` as const;
const {title, cardTitle, summary, technologies, heroImage, heroAlt} = project.data;
---

<article class="group relative flex min-h-84 flex-col border border-ink bg-paper p-[clamp(1.5rem,4vw,3rem)] transition duration-160 hover:-translate-y-1 hover:shadow-[0.4rem_0.4rem_0_var(--color-moss)] motion-reduce:transition-none motion-reduce:hover:transform-none">
  <a class="mb-6 block" href={`/software/${project.id}/`} tabindex="-1">
    <Image class="w-full" src={heroImage} alt={heroAlt} widths={[400, 800]} sizes="(min-width: 60rem) 30rem, 100vw" />
  </a>

  <Heading class="text-[clamp(1.75rem,1.4rem+1vw,2.4rem)]">
    <a class="after:absolute after:inset-0" href={`/software/${project.id}/`}>
      {cardTitle ?? title}
      {cardTitle !== undefined && <span class="sr-only"> {title}</span>}
    </a>
  </Heading>

  <p class="max-w-[34rem]">{summary}</p>

  <Eyebrow>{technologies.join(" · ")}</Eyebrow>
</article>
