---
import Button from "@src/components/actions/button/Button.astro";
import {newTabNotice} from "@src/components/actions/external-link/NewTabNotice";
import GitHubMark from "./components/github-mark/GitHubMark.astro";

interface Props {
  title: string;
  repositoryUrl: URL;
  liveUrl?: URL;
  liveLabel?: string;
  selfLink?: boolean;
}

const {title, repositoryUrl, liveUrl, liveLabel = "Visit live site", selfLink = false} = Astro.props;
---

<div class="flex flex-wrap items-center gap-3">
  {liveUrl !== undefined && (
    <Button variant="primary" href={liveUrl.href} data-self-link={selfLink || undefined}>
      {liveLabel}
      <span class="ml-2" aria-hidden="true">
        ↗
      </span>
    </Button>
  )}

  <Button
    variant="secondary"
    shape="icon"
    href={repositoryUrl.href}
    aria-label={`${title} repository on GitHub ${newTabNotice}`}
  >
    <GitHubMark class="size-6" />
  </Button>
</div>
