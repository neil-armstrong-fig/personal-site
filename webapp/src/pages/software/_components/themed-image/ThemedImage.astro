---
import type {ImageMetadata} from "astro";
import {Image} from "astro:assets";

// One image, or a light and a dark pair swapped by the theme. The dark image is always lazy: it sits in a hidden box in
// light mode, so the browser does not fetch it until it is shown.
interface Props {
  src: ImageMetadata;
  darkSrc?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  class?: string;
}

const {src, darkSrc, alt, widths, sizes, eager = false, class: className} = Astro.props;
const hasDark = darkSrc !== undefined;
let loading: "eager" | "lazy" = "lazy";
let fetchpriority: "high" | "auto" = "auto";

if (eager) {
  loading = "eager";
  fetchpriority = "high";
}
---

<Image
  class:list={[className, hasDark && "dark:hidden"]}
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  loading={loading}
  fetchpriority={fetchpriority}
/>

{hasDark && (
  <Image
    class:list={[className, "hidden dark:block"]}
    src={darkSrc}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading="lazy"
  />
)}
