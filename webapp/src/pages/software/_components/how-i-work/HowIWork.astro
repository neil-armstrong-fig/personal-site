---
import Container from "@src/components/layout/container/Container.astro";
import Eyebrow from "@src/components/typography/eyebrow/Eyebrow.astro";

interface Principle {
  title: string;
  description: string;
}

const principles: readonly Principle[] = [
  {
    title: "Product first",
    description: "I start from what users need, then work back to the architecture.",
  },
  {
    title: "Make the idea real early",
    description: "Working end-to-end prototypes give product, design, and engineering something concrete to test.",
  },
  {
    title: "Tests enable change",
    description: "Readable acceptance tests turn requirements into evidence and make ambitious changes safer.",
  },
  {
    title: "Quality that is enforced",
    description: "Boundaries, linting, and pipelines are checked by tooling, not good intentions.",
  },
];
---

<section class="border-y border-moss bg-paper-muted py-8">
  <Container>
    <Eyebrow>What sets me apart</Eyebrow>

    <ul class="grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {principles.map(principle => (
        <li>
          <h2 class="mb-2 text-[1.35rem]">{principle.title}</h2>

          <p class="mb-0 max-w-copy">{principle.description}</p>
        </li>
      ))}
    </ul>
  </Container>
</section>
