---
import Container from "@src/components/layout/container/Container.astro";
import Section from "@src/components/layout/section/Section.astro";
import SectionHeading from "@src/components/layout/section-heading/SectionHeading.astro";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import {getPublishedProfessionalCaseStudies} from "@src/content/professional-case-study/GetPublishedProfessionalCaseStudies";
import {getPublishedProjects} from "@src/content/project/GetPublishedProjects";
import HowIWork from "./_components/how-i-work/HowIWork.astro";
import ProfessionalCaseStudyCard from "./_components/professional-case-study-card/ProfessionalCaseStudyCard.astro";
import ProjectCard from "./_components/project-card/ProjectCard.astro";
import {buildSoftwareCollectionPageNode} from "./_components/software-collection-page-node/SoftwareCollectionPageNode";

const projects = await getPublishedProjects();
const professionalCaseStudies = await getPublishedProfessionalCaseStudies();
const description =
  "Software architecture and engineering work by Neil Armstrong: new product delivery, event-driven AWS systems, AI-native engineering, and safe modernisation.";
---

<BaseLayout
  title="Software architecture and engineering | Neil Armstrong"
  description={description}
  structuredData={[
    buildSoftwareCollectionPageNode({
      description,
      path: "/software/",
      professionalCaseStudies,
      projects,
    }),
  ]}
>
  <Section>
    <Container>
      <SectionHeading
        compact
        eyebrow="Software"
        heading="Software architecture and engineering"
        intro="I’m Neil Armstrong, a Belfast software architect and developer. I take products from early ideas to working software, transform systems that are hard to change, and use tests written in the language of the product as evidence."
      />
    </Container>
  </Section>

  <HowIWork />

  <Section id="professional-work">
    <Container>
      <SectionHeading
        level={2}
        eyebrow="Professional work"
        heading="What I have delivered"
        intro="These case studies are anonymised, but the systems, decisions, and outcomes are real."
      />

      <div class="grid gap-4 md:grid-cols-2">
        {professionalCaseStudies.map(caseStudy => (
          <ProfessionalCaseStudyCard caseStudy={caseStudy} />
        ))}
      </div>
    </Container>
  </Section>
  <Section class="border-t border-moss bg-paper-muted" id="open-source">
    <Container>
      <SectionHeading
        level={2}
        eyebrow="Open source"
        heading="Projects built in the open"
        intro="Useful software you can use today, and a closer look at the architecture, testing, and delivery decisions behind it."
      />

      {projects.length === 0 && <p>Open-source case studies are in preparation.</p>}

      {projects.length > 0 && (
        <div class="grid gap-4 md:grid-cols-2">
          {projects.map(project => (
            <ProjectCard project={project} />
          ))}
        </div>
      )}
    </Container>
  </Section>
</BaseLayout>
