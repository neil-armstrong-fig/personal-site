---
import type {HTMLAttributes} from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  compact?: boolean;
}

const {class: className, compact = false, ...attributes} = Astro.props;
---

<section
  class:list={[
    "relative",
    compact && "py-[clamp(2rem,4vw,3.5rem)]",
    !compact && "py-[clamp(4rem,9vw,8rem)]",
    className,
  ]}
  {...attributes}
>
  <slot />
</section>
