---
import Container from "@src/components/layout/container/Container.astro";
import SocialLinks from "@src/layouts/components/site-footer/components/social-links/SocialLinks.astro";
import {siteConfig} from "@src/site/SiteConfig";

const currentYear = new Date().getFullYear();
---

<footer class="bg-ink py-12 text-paper">
  <Container class="grid gap-8 md:grid-cols-[minmax(18rem,1fr)_auto] md:items-start">
    <div>
      <p class="mb-0 font-serif text-[1.6rem] font-[650]">{siteConfig.identity.name}</p>

      <p class="mb-0">{siteConfig.identity.publicTitle} in Belfast.</p>
    </div>

    <SocialLinks />

    <p class="mb-0 max-w-[55rem] text-[0.82rem] md:col-span-full">
      © {currentYear} {siteConfig.identity.name}. Code MIT licensed; writing and photography reserved.{" "}
      <a href="/privacy/" class="underline underline-offset-4">
        Privacy
      </a>
    </p>
  </Container>
</footer>
