---
import type {HTMLAttributes} from "astro/types";

type Props = HTMLAttributes<"svg">;

const {class: className, ...attributes} = Astro.props;
---

<svg
  class:list={["absolute fill-none stroke-current", className]}
  viewBox="0 0 24 24"
  stroke-width="1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...attributes}
>
  <path d="M7.5 7h9a4.5 4.5 0 0 1 4.4 3.6l.9 4.6a2.6 2.6 0 0 1-4.5 2.1L15.5 15h-7l-1.8 2.3a2.6 2.6 0 0 1-4.5-2.1l.9-4.6A4.5 4.5 0 0 1 7.5 7Z"></path>

  <path d="M8 9.5v3M6.5 11h3"></path>

  <circle cx="15.5" cy="10.2" r=".6"></circle>

  <circle cx="17.5" cy="12" r=".6"></circle>
</svg>
