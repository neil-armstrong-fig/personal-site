---
import type {HTMLAttributes} from "astro/types";

type Props = HTMLAttributes<"svg">;

const {class: className, ...attributes} = Astro.props;
---

<svg
  class:list={["absolute fill-none stroke-current", className]}
  viewBox="0 0 24 24"
  stroke-width="1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...attributes}
>
  <circle cx="5.5" cy="16" r="3.5"></circle>

  <circle cx="18.5" cy="16" r="3.5"></circle>

  <path d="M5.5 16 9 8h7l2.5 8M9 8l3.5 8H5.5M16 8l-1-3h-2.5M8 8H6.5"></path>
</svg>
