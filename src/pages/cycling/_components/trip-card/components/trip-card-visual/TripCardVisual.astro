---
import {Image} from "astro:assets";
import type {ImageMetadata} from "astro";
import type {CollectionEntry} from "astro:content";

import {getTripFerries} from "@src/content/trip/ferries/GetTripFerries";
import {getTripRoutes} from "@src/content/trip/strava/routes/GetTripRoutes";
import {getTripSnapshot} from "@src/content/trip/strava/snapshot/GetTripSnapshot";
import {getTripTransitGaps} from "@src/content/trip/transit-gaps/GetTripTransitGaps";
import {getTripTransitRoutes} from "@src/content/trip/transit-routes/GetTripTransitRoutes";
import {getTripStoryFigures} from "@src/content/trip/trip-figures/story-figures/TripStoryFigures";
import {buildTripMapActivities} from "@src/pages/cycling/_components/trip-route-map/activities/BuildTripMapActivities";
import TripRouteMap from "@src/pages/cycling/_components/trip-route-map/TripRouteMap.astro";
import type {TripMapActivity} from "@src/pages/cycling/_components/trip-route-map/types/TripMapActivity";

type OptionalImage = ImageMetadata | undefined;
type ImageLoading = "eager" | "lazy";
type ImageFetchPriority = "high" | "auto";

interface Props {
  trip: CollectionEntry<"trips">;
  prioritiseImages?: boolean;
}

const storyImages = import.meta.glob<ImageMetadata>("/src/content/trip/entries/*/_assets/*.{avif,jpeg,jpg,png,webp}", {
  eager: true,
  import: "default",
});

const {trip, prioritiseImages = false} = Astro.props;
const {coverImage, coverAlt, title} = trip.data;
const storyFigure = getTripStoryFigures(trip)[0];
const storyImage = storyFigure && resolveStoryImage(trip.id, storyFigure.path);
const snapshot = getTripSnapshot(trip.id);
const routes = getTripRoutes(trip.id);
const ferries = getTripFerries(trip.id);
const transitGaps = getTripTransitGaps(trip.id);
const transitRoutes = getTripTransitRoutes(trip.id);
let mapActivities: TripMapActivity[] = [];
let loading: ImageLoading = "lazy";
let fetchPriority: ImageFetchPriority = "auto";

if (snapshot !== undefined && routes !== undefined) {
  mapActivities = buildTripMapActivities(snapshot, new Set(Object.keys(routes.routes)));
}

if (prioritiseImages) {
  loading = "eager";
  fetchPriority = "high";
}

function resolveStoryImage(tripId: string, path: string): OptionalImage {
  const relativePath = path.replace(/^\.\//, "");

  return storyImages[`/src/content/trip/entries/${tripId}/${relativePath}`];
}
---

<div class="grid aspect-[16/10] grid-cols-[minmax(0,3fr)_minmax(7rem,2fr)] gap-1 bg-ink p-1">
  <TripRouteMap
    activities={mapActivities}
    ferries={ferries}
    transitGaps={transitGaps}
    transitRoutes={transitRoutes}
    routesUrl={`/cycling/${trip.id}/routes.json`}
    title={title}
    variant="archive"
  />

  <div class:list={["grid min-w-0 gap-1", storyImage !== undefined && "grid-rows-2"]}>
    <div class="relative min-h-0 overflow-hidden bg-paper-muted">
      <Image
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02] motion-reduce:transition-none"
        src={coverImage}
        alt={coverAlt}
        widths={[240, 280, 400, 560]}
        sizes="(min-width: 64rem) 15rem, (min-width: 48rem) 20vw, 38vw"
        loading={loading}
        fetchpriority={fetchPriority}
      />
    </div>

    {storyImage !== undefined && storyFigure !== undefined && (
      <div class="relative min-h-0 overflow-hidden bg-paper-muted">
        <Image
          class="absolute inset-0 h-full w-full object-cover"
          src={storyImage}
          alt={storyFigure.alt}
          widths={[240, 280, 400, 560]}
          sizes="(min-width: 64rem) 15rem, (min-width: 48rem) 20vw, 38vw"
          loading="lazy"
        />
      </div>
    )}
  </div>
</div>
