---
import {render} from "astro:content";
import type {CollectionEntry} from "astro:content";
import type {GetStaticPaths} from "astro";

import {getPublishedTrips} from "@src/content/trip/GetPublishedTrips";
import {getPublishedTripChapters} from "@src/content/trip/trip-chapter/GetPublishedTripChapters";
import {firstPartDateRange} from "@src/content/trip/trip-chapter/FirstPartDateRange";
import {getTripFerries} from "@src/content/trip/ferries/GetTripFerries";
import {findNeighbours} from "@src/pages/cycling/_components/neighbours/FindNeighbours";
import {getTripRideMedia} from "@src/content/trip/strava/ride-media/TripRideMedia";
import {getTripRoutes} from "@src/content/trip/strava/routes/GetTripRoutes";
import {getTripSnapshot} from "@src/content/trip/strava/snapshot/GetTripSnapshot";
import {getTripTransitGaps} from "@src/content/trip/transit-gaps/GetTripTransitGaps";
import {getTripTransitRoutes} from "@src/content/trip/transit-routes/GetTripTransitRoutes";
import type {Neighbours} from "@src/pages/cycling/_components/neighbours/types/Neighbours";
import {buildBlogPostingNode} from "@src/pages/cycling/_components/blog-posting-node/BlogPostingNode";
import {buildBreadcrumbListNode} from "@src/pages/_components/breadcrumb-list-node/BreadcrumbListNode";
import {buildTripMapActivities} from "@src/pages/cycling/_components/trip-route-map/activities/BuildTripMapActivities";
import type {TripMapActivity} from "@src/pages/cycling/_components/trip-route-map/types/TripMapActivity";
import CyclingTripLayout from "./_components/cycling-trip-layout/CyclingTripLayout.astro";
import RideLog from "./_components/ride-log/RideLog.astro";
import RouteVisual from "./_components/route-visual/RouteVisual.astro";
import TripChapterLinks from "@src/pages/cycling/_components/trip-chapter-links/TripChapterLinks.astro";
import TripChapterToc from "./_components/trip-chapter-toc/TripChapterToc.astro";
import TripStats from "./_components/trip-stats/TripStats.astro";

export const getStaticPaths = (async () => {
  const trips = await getPublishedTrips();

  return Promise.all(
    trips.map(async trip => ({
      params: {slug: trip.id},
      props: {trip, neighbours: findNeighbours(trips, trip.id), chapters: await getPublishedTripChapters(trip.id)},
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  trip: CollectionEntry<"trips">;
  neighbours: Neighbours<CollectionEntry<"trips">>;
  chapters: CollectionEntry<"tripChapters">[];
}

const {trip, neighbours, chapters} = Astro.props;
const {title, summary, coverImage, coverAlt, comingSoon, dateModified, seoTitle, seoDescription, firstPartTitle} =
  trip.data;
const path = `/cycling/${trip.id}/`;
const heading = chapters.length > 0 ? `Part 1 of ${chapters.length + 1}: ${firstPartTitle ?? title}` : title;
let firstPartRange: ReturnType<typeof firstPartDateRange> | undefined;

if (chapters.length > 0) {
  firstPartRange = firstPartDateRange(
    trip.data,
    chapters.map(chapter => chapter.data),
  );
}
const snapshot = getTripSnapshot(trip.id);
const routes = getTripRoutes(trip.id);
const ferries = getTripFerries(trip.id);
const transitGaps = getTripTransitGaps(trip.id);
const transitRoutes = getTripTransitRoutes(trip.id);
const rideMedia = getTripRideMedia(trip.id);
let mapActivities: TripMapActivity[] = [];

if (snapshot !== undefined && routes !== undefined) {
  mapActivities = buildTripMapActivities(snapshot, new Set(Object.keys(routes.routes)));
}

const {Content} = await render(trip);
---

<CyclingTripLayout
  title={seoTitle ?? `${heading} | Neil Armstrong`}
  description={seoDescription}
  heading={heading}
  intro={summary}
  structuredData={[
    buildBlogPostingNode({headline: heading, description: seoDescription, path, dateModified}),
    buildBreadcrumbListNode([
      {name: "Cycling", path: "/cycling/"},
      {name: heading, path},
    ]),
  ]}
>
  <TripStats slot="meta" trip={trip} variant="masthead" />

  {firstPartRange !== undefined && <TripStats slot="meta" trip={trip} variant="masthead" partRange={firstPartRange} />}

  {!comingSoon && <TripChapterLinks slot="meta" trip={trip} chapters={chapters} tripPath={path} currentOrder={1} />}

  <RouteVisual
    slot="route-visual"
    activities={mapActivities}
    ferries={ferries}
    transitGaps={transitGaps}
    transitRoutes={transitRoutes}
    routesUrl={`${path}routes.json`}
    title={title}
    image={coverImage}
    alt={coverAlt}
  />

  {comingSoon && <p>Still working on the write-up! Enjoy the others until then :)</p>}

  {!comingSoon && <Content />}

  <Fragment slot="after">
    {!comingSoon && <TripChapterToc chapters={chapters} tripPath={path} totalParts={chapters.length + 1} />}

    {snapshot !== undefined && routes !== undefined && (
      <RideLog
        ferries={ferries}
        snapshot={snapshot}
        routeActivityIds={Object.keys(routes.routes)}
        routesUrl={`${path}routes.json`}
        rideMedia={rideMedia}
        transitGaps={transitGaps}
        transitRoutes={transitRoutes}
      />
    )}

    <nav
      class="mt-12 grid gap-4 border-t border-moss/60 pt-8 sm:grid-cols-2"
      aria-label="Other trips"
      hidden={neighbours.previous === undefined && neighbours.next === undefined}
    >
      {neighbours.next !== undefined && (
        <a class="border border-moss/60 p-5" href={`/cycling/${neighbours.next.id}/`} rel="prev">
          <span class="block font-mono text-xs tracking-[0.1em] text-petrol uppercase">← Earlier trip</span>

          <span class="mt-1 block">{neighbours.next.data.title}</span>
        </a>
      )}

      {neighbours.previous !== undefined && (
        <a class="border border-moss/60 p-5 sm:text-right" href={`/cycling/${neighbours.previous.id}/`} rel="next">
          <span class="block font-mono text-xs tracking-[0.1em] text-petrol uppercase">Later trip →</span>

          <span class="mt-1 block">{neighbours.previous.data.title}</span>
        </a>
      )}
    </nav>
  </Fragment>
</CyclingTripLayout>

<script>
  import {initialiseRouteMaps} from "./_components/route-maps/RouteMaps";

  initialiseRouteMaps();
</script>
