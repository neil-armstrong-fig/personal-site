---
import {render} from "astro:content";
import type {CollectionEntry} from "astro:content";

import Eyebrow from "@src/components/typography/eyebrow/Eyebrow.astro";
import ArticleLayout from "@src/pages/software/_components/article-layout/ArticleLayout.astro";
import ProfessionalCaseStudyCard from "@src/pages/software/_components/professional-case-study-card/ProfessionalCaseStudyCard.astro";
import {buildProfessionalCaseStudyNode} from "@src/pages/software/_components/professional-case-study/professional-case-study-node/ProfessionalCaseStudyNode";
import {buildBreadcrumbListNode} from "@src/pages/_components/breadcrumb-list-node/BreadcrumbListNode";

interface Props {
  caseStudy: CollectionEntry<"professionalCaseStudies">;
  related: CollectionEntry<"professionalCaseStudies">[];
}

const {caseStudy, related} = Astro.props;
const {title, summary, careerPeriod, technologies, seoTitle, seoDescription} = caseStudy.data;
const path = `/software/${caseStudy.id}/`;
const {Content} = await render(caseStudy);
---

<ArticleLayout
  title={seoTitle ?? `${title} | Neil Armstrong`}
  description={seoDescription}
  eyebrow="Professional case study"
  heading={title}
  intro={summary}
  structuredData={[
    buildProfessionalCaseStudyNode({
      headline: title,
      description: seoDescription,
      path,
      technologies,
    }),
    buildBreadcrumbListNode([
      {name: "Software", path: "/software/"},
      {name: title, path},
    ]),
  ]}
>
  <Fragment slot="meta">
    <Eyebrow>
      {careerPeriod} · {technologies.join(" · ")}
    </Eyebrow>
  </Fragment>

  <Content />

  <section slot="after" class="mt-16" aria-labelledby="related-professional-work" hidden={related.length === 0}>
    <h2 id="related-professional-work" class="text-[clamp(1.75rem,1.4rem+1.2vw,2.4rem)] tracking-[-0.03em]">
      More professional case studies
    </h2>

    <div class="grid gap-4 md:grid-cols-2">
      {related.map(other => (
        <ProfessionalCaseStudyCard caseStudy={other} level={3} />
      ))}
    </div>
  </section>
</ArticleLayout>
