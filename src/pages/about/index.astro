---
import ExternalLink from "@src/components/actions/external-link/ExternalLink.astro";
import Container from "@src/components/layout/container/Container.astro";
import Section from "@src/components/layout/section/Section.astro";
import Eyebrow from "@src/components/typography/eyebrow/Eyebrow.astro";
import Prose from "@src/components/typography/prose/Prose.astro";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import {siteConfig} from "@src/site/SiteConfig";
import {buildProfilePageNode} from "@src/pages/about/_components/profile-page-node/ProfilePageNode";

const description =
  "About Neil Armstrong, a Belfast software architect and developer specialising in resilient AWS systems, TypeScript products, continuous delivery, and AI-native engineering.";
---

<BaseLayout
  title="About Neil Armstrong | Software Architect in Belfast"
  description={description}
  openGraphType="profile"
  structuredData={[buildProfilePageNode({path: "/about/", description})]}
>
  <Section>
    <Container>
      <Prose>
        <Eyebrow>About</Eyebrow>

        <h1>About Neil Armstrong</h1>

        <p>
          I’m a software architect and developer in Belfast with a First Class Honours degree in Computer Science from
          Ulster University and more than a decade of experience solving complex delivery problems.
        </p>

        <p>
          My work spans new TypeScript and React products, resilient AWS and event-driven systems, and the modernisation
          of established software. I enjoy taking ideas from prototype to production and enabling cross-functional teams
          to deliver continuously, with architecture and pipelines that make safe changes routine — and dare I say, fun.
        </p>

        <p>
          Cycling is my counterweight to software. Lots of planning and logistics to contend with on solo trips, but
          great adventures.
        </p>

        <p>
          I care about clear boundaries in the products I build: quality that is enforced rather than hoped for, and
          products people actually find useful. That includes extremely low regressions via acceptance tests written in
          readable, maintainable domain-specific languages. I use AI-native engineering practices where they improve
          delivery, with a person still accountable for every decision and result, not just speed at all costs.
        </p>

        <p>
          My open-source projects make that approach visible: the architecture, tests, delivery tooling, and trade-offs,
          not just the finished interface.
        </p>

        <p>
          I’m open to conversations about interesting work.{" "}
          <ExternalLink href={siteConfig.socialLinks.linkedIn.href}>Message me on LinkedIn</ExternalLink>.
        </p>
      </Prose>
    </Container>
  </Section>
</BaseLayout>
