# Private source material must never be committed or deployed.
/private-source/
# Trip clips are served from the media origin (see AGENTS.md), never from the repository.
/webapp/public/trips/**/*.mp4
*:Zone.Identifier

# Local and generated project files.
node_modules/
/webapp/dist/
/webapp/.astro/
/webapp/.lighthouseci/
coverage/
/.env
/.env.*
!.env.example
*.log
.DS_Store
# Stray Windows-style directories created by Chrome under WSL.
/C:*
# Cloudflare Worker local state and secrets (the contact Worker reads its secrets from .dev.vars under `wrangler dev`).
/workers/*/.wrangler/
/workers/*/.dev.vars
