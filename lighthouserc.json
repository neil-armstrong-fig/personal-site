{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/about/index.html",
        "http://localhost/privacy/index.html",
        "http://localhost/software/index.html",
        "http://localhost/software/janggi/index.html",
        "http://localhost/cycling/index.html",
        "http://localhost/cycling/tokyo-to-seoul/index.html",
        "http://localhost/cycling/tokyo-to-seoul/shimanami-kaido-to-hiroshima/index.html",
        "http://localhost/cycling/loop-of-europe/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
