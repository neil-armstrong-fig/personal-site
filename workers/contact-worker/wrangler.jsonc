{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site-contact",
  "main": "src/ContactWorker.ts",
  "compatibility_date": "2026-09-01",
  // Served only from the custom domain; Cloudflare creates its DNS record on deploy.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "contact.neilarmstrong.dev", "custom_domain": true}],
  // No `destination_address`: the recipient is the CONTACT_TO_ADDRESS secret, so it never enters git.
  // Email Routing still only delivers to an address verified in the dashboard.
  "send_email": [{"name": "CONTACT_MAIL"}],
  "vars": {
    "ALLOWED_ORIGIN": "https://neilarmstrong.dev",
    "CONTACT_FROM_ADDRESS": "contact@neilarmstrong.dev",
  },
  // Secrets, set with `wrangler secret put` (or in .dev.vars locally): TURNSTILE_SECRET, CONTACT_TO_ADDRESS.
}
